# Website
WEBSITE_PORT=3000
VITE_API_URL=http://localhost:3001

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=3001
# Railway provides PORT automatically; when present it takes precedence over SERVER_PORT.
# PORT=
WEBSITE_URL=http://localhost:3000
LOG_LEVEL=debug
LOG_PRETTY=true
# Keep false locally. In production, configure the exact trusted proxy hop count.
TRUST_PROXY=false

# Artificial intelligence (real calls stay opt-in in development and tests)
AI_REAL_CALLS_ENABLED=false
AI_MODEL=gpt-6-luna
AI_GENERATION_TIMEOUT_MS=45000
OPENAI_API_KEY=

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/lazuli

# Authentication
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Transactional email
RESEND_API_KEY=re_replace_me
AUTH_EMAIL_FROM=Lazúli <onboarding@resend.dev>

# Private object storage (MinIO locally, S3-compatible in production)
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=lazuli-assets
S3_ACCESS_KEY_ID=lazuli
S3_SECRET_ACCESS_KEY=lazuli-local-secret
# MinIO uses path-style URLs and may create the local bucket. Production does neither.
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET_IF_MISSING=true
