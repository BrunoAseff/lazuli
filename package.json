{
  "name": "lazuli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:generate": "vp run server#db:generate",
    "db:migrate": "vp run server#db:migrate",
    "db:studio": "vp run server#db:studio",
    "db:up": "docker compose up -d postgres",
    "ready": "vp check && vp test && vp run -r build",
    "dev": "vp run --filter './apps/*' dev",
    "dev:website": "vp run website#dev",
    "dev:server": "vp run server#dev",
    "prepare": "vp config"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.32.1"
}
